# ---------------------------------------------------------------- the trunk
# $ROOT — the depth-0 coin of the tree, a standard pump.fun coin paired with SOL.
# Leave empty to serve the page in "not planted yet" mode (no cycles).
ROOT_MINT=
# the creator wallet of $ROOT (bs58 from Phantom/Solflare, or a JSON byte array). With it the
# trunk drinks (claims its SOL fees, buys $ROOT back and burns it). Without it: watch mode.
ROOT_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------- the launchpad
# every coin grown on the tree gets its own engine wallet (creator = engine); keys are AES-256-GCM
# encrypted at rest with this 32-byte hex key (openssl rand -hex 32). Unset = stored in clear (dev only).
MASTER_KEY=
# the tax every grown coin is born with, in bps, paid in the coin it grows on (pump.fun's own fee is on top)
CREATOR_TAX_BPS=100
# how deep the tree may grow. 0 = whatever pump.fun allows right now (Global.max_curve_depth, 2 since Oct 13)
MAX_DEPTH=0
# what the user deposits on top of the dev buy: create_v2 rent + fees + the coin wallet's permanent gas reserve
LAUNCH_GAS_SOL=0.06
MAX_DEV_BUY_SOL=10
DEPOSIT_TIMEOUT_MIN=30

# ---------------------------------------------------------------- the sap run (one clock for every coin)
CYCLE_INTERVAL_SEC=600
# split of every coin's claimed sap, in bps (must add up to 10000)
SELF_SHARE_BPS=5000      # buys the coin itself back and burns it
DOWN_SHARE_BPS=5000      # burns the coin it grows on ("sap flows down"); for $ROOT this share also buys $ROOT back
OPS_SHARE_BPS=0          # optional ops wallet, in the coin's quote
OPS_WALLET=
MIN_CLAIM_USD=0.1
MIN_SAP_USD=0.25          # a pot under this waits for the next run
GAS_RESERVE_SOL=0.02
MIN_GAS_SOL=0.004
GAS_REFILL_BELOW_SOL=0.012
GAS_REFILL_USD=1.5        # under GAS_REFILL_BELOW_SOL a slice of the pot is sold down the chain to SOL (0 = off)
SLIPPAGE_PCT=5
CYCLE_CONCURRENCY=3
EXCLUDED_WALLETS=

# ---------------------------------------------------------------- engine
SCHEDULER_ENABLED=true
DRY_RUN=false
POLL_SEC=15
PRIORITY_MICRO_LAMPORTS=100000
ADMIN_KEY=

# ---------------------------------------------------------------- infra
PORT=4000
DATABASE_URL=postgres://localhost:5432/root
RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------- brand
BRAND_NAME=ROOT
SITE_URL=http://localhost:4000
PUBLIC_API_URL=
BRAND_TWITTER=
BRAND_TELEGRAM=
