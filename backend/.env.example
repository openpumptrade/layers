# ---------------------------------------------------------------- the base layer
# $L1 — the depth-0 coin of the stack, a standard pump.fun coin paired with SOL.
# Leave empty to serve the page in "genesis pending" mode (no settlements).
L1_MINT=
# the creator wallet of $L1 (bs58 from Phantom/Solflare, or a JSON byte array). With it $L1 settles
# (claims its SOL fees, buys $L1 back and burns it). Without it: watch mode.
L1_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------- the launchpad
# every layer launched on the stack gets its own sequencer wallet (creator = engine); keys are AES-256-GCM
# encrypted at rest with this 32-byte hex key (openssl rand -hex 32). Unset = stored in clear (dev only).
MASTER_KEY=
# the tax every layer is born with, in bps, paid in the layer it runs on (pump.fun's own fee is on top)
CREATOR_TAX_BPS=100
# how deep the stack may go. 0 = whatever pump.fun allows right now (Global.max_curve_depth, 2 since Oct 13)
MAX_DEPTH=0
# what the user deposits on top of the dev buy: create_v2 rent + fees + the coin wallet's permanent gas reserve
LAUNCH_GAS_SOL=0.06
MAX_DEV_BUY_SOL=10
DEPOSIT_TIMEOUT_MIN=30

# ---------------------------------------------------------------- the settlement (one clock for every coin)
CYCLE_INTERVAL_SEC=600
# split of every coin's claimed fees, in bps (must add up to 10000)
SELF_SHARE_BPS=5000      # buys the coin itself back and burns it
DOWN_SHARE_BPS=5000      # burns the layer it runs on ("fees settle down"); for $L1 this share also buys $L1 back
OPS_SHARE_BPS=0          # optional ops wallet, in the coin's quote
OPS_WALLET=
MIN_CLAIM_USD=0.1
MIN_SAP_USD=0.25          # a pot under this waits for the next settlement
GAS_RESERVE_SOL=0.02
MIN_GAS_SOL=0.004
GAS_REFILL_BELOW_SOL=0.012
GAS_REFILL_USD=1.5        # under GAS_REFILL_BELOW_SOL a slice of the pot is sold down the chain to SOL (0 = off)
SLIPPAGE_PCT=5
CYCLE_CONCURRENCY=3
EXCLUDED_WALLETS=

# ---------------------------------------------------------------- engine
SCHEDULER_ENABLED=true
DRY_RUN=false
POLL_SEC=15
PRIORITY_MICRO_LAMPORTS=100000
ADMIN_KEY=

# ---------------------------------------------------------------- infra
PORT=4000
DATABASE_URL=postgres://localhost:5432/layers
RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------- brand
BRAND_NAME=LAYERS
SITE_URL=http://localhost:4000
PUBLIC_API_URL=
BRAND_TWITTER=
BRAND_TELEGRAM=
